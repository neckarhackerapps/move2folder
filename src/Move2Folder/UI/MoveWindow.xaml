<Window x:Class="Move2Folder.UI.MoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Move2Folder.Models"
        mc:Ignorable="d"
        Title="Move2Folder"
        Height="630" Width="580"
        MinHeight="460" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Modern Colors -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#201F1E"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#605E5C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E1DFDD"/>
        <SolidColorBrush x:Key="HighlightMatchBrush" Color="#EFF6FC"/>

        <!-- TreeView Item Style -->
        <Style x:Key="FolderTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5E5E5"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#201F1E"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5E5E5"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#201F1E"/>
            </Style.Resources>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#201F1E"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TreeView Item Template -->
        <HierarchicalDataTemplate DataType="{x:Type models:FolderItem}" ItemsSource="{Binding Children}">
            <Border CornerRadius="4" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <!-- Icon based on folder type -->
                    <TextBlock FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="Text" Value="&#xED25;"/>
                                <!-- Folder icon -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStore}" Value="True">
                                        <Setter Property="Text" Value="&#xE715;"/>
                                        <!-- Mailbox icon -->
                                        <Setter Property="Foreground" Value="#107C41"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Inbox">
                                        <Setter Property="Text" Value="&#xE715;"/>
                                        <!-- Inbox icon -->
                                        <Setter Property="Foreground" Value="#0078D4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Sent">
                                        <Setter Property="Text" Value="&#xE724;"/>
                                        <!-- Sent mail icon -->
                                        <Setter Property="Foreground" Value="#0078D4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Archive">
                                        <Setter Property="Text" Value="&#xE7B8;"/>
                                        <!-- Archive icon -->
                                        <Setter Property="Foreground" Value="#D83B01"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Trash">
                                        <Setter Property="Text" Value="&#xE74D;"/>
                                        <!-- Trash icon -->
                                        <Setter Property="Foreground" Value="#A80000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Drafts">
                                        <Setter Property="Text" Value="&#xE70F;"/>
                                        <!-- Edit/Draft icon -->
                                        <Setter Property="Foreground" Value="#5C2D91"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FolderType}" Value="Junk">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <!-- Warning icon -->
                                        <Setter Property="Foreground" Value="#D83B01"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Folder Name -->
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStore}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Info header -->
            <RowDefinition Height="Auto"/>
            <!-- Search bar -->
            <RowDefinition Height="*"/>
            <!-- Folder tree -->
            <RowDefinition Height="Auto"/>
            <!-- Selected path label -->
            <RowDefinition Height="Auto"/>
            <!-- Actions & Shortcuts -->
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                <TextBlock x:Name="HeaderIcon" DockPanel.Dock="Left" Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtItemCount" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtItemSubject" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search Box with Placeholder -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     FontSize="14"
                     Padding="32,6,10,6"
                     VerticalContentAlignment="Center"
                     BorderBrush="#8A8886"
                     BorderThickness="1"
                     TextChanged="SearchTextBox_TextChanged"
                     PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Search Icon -->
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>

            <!-- Placeholder Text -->
            <TextBlock x:Name="PlaceholderText"
                       FontSize="13"
                       Foreground="#A19F9D"
                       VerticalAlignment="Center"
                       Margin="34,0,0,0"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Folder Tree -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="4">
            <TreeView x:Name="FolderTree"
                       ItemContainerStyle="{StaticResource FolderTreeViewItemStyle}"
                       SelectedItemChanged="FolderTree_SelectedItemChanged"
                       MouseDoubleClick="FolderTree_MouseDoubleClick"
                       PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                       BorderThickness="0"
                       Background="Transparent">
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#201F1E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#201F1E"/>
                </TreeView.Resources>
                <TreeView.ContextMenu>
                    <ContextMenu x:Name="FolderContextMenu" Opened="FolderContextMenu_Opened">
                        <MenuItem x:Name="MenuNewFolder" Click="MenuNewFolder_Click" InputGestureText="Strg+Umschalt+N">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="MenuSeparator1"/>
                        <MenuItem x:Name="MenuMoveHere" Click="MenuMoveHere_Click" InputGestureText="Enter">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuOpenFolder" Click="MenuOpenFolder_Click" InputGestureText="Shift+Enter">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="MenuSeparator2"/>
                        <MenuItem x:Name="MenuRefresh" Click="MenuRefresh_Click" InputGestureText="F5">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </Border>

        <!-- Selected Path Display -->
        <Border Grid.Row="3" Margin="0,8,0,10" Padding="4,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtSelectedPathPrefix" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtSelectedPath" FontSize="12" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>

        <!-- Action Buttons & Shortcuts Hint -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Keyboard shortcut guide -->
            <Border Grid.Row="0" Margin="0,0,0,10" Background="#F3F2F1" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="TxtShortcutGuide" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </Border>

            <!-- Action Buttons -->
            <DockPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnRefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="34" Height="34"
                            Click="BtnRefresh_Click"
                            Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnNewFolder" Content="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="34" Height="34"
                            Click="BtnNewFolder_Click"
                            Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="110" Height="34" Margin="0,0,8,0"
                            Click="BtnCancel_Click" Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" FontSize="12">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnOpenOnly" Content="Open Only" Width="140" Height="34" Margin="0,0,8,0"
                            Click="BtnOpenOnly_Click" Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" FontSize="12">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnMove" Content="Move" MinWidth="140" Height="34" Padding="12,0"
                            Click="BtnMove_Click" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF"
                            FontWeight="SemiBold" BorderThickness="0" FontSize="12">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
