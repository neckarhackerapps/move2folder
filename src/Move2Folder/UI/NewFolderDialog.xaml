<Window x:Class="Move2Folder.UI.NewFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Neuer Ordner"
        Height="230" Width="460"
        MinHeight="230" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#201F1E"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#605E5C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E1DFDD"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#A80000"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Location -->
            <RowDefinition Height="Auto"/> <!-- Input Label -->
            <RowDefinition Height="Auto"/> <!-- Input TextBox -->
            <RowDefinition Height="Auto"/> <!-- Validation Error -->
            <RowDefinition Height="*"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header / Parent Folder Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Neuen Ordner erstellen" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <DockPanel Margin="26,0,0,0" LastChildFill="True">
                <TextBlock x:Name="TxtParentPrefix" Text="Erstellen in: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtParentPath" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </StackPanel>

        <!-- Input Label -->
        <TextBlock x:Name="TxtNameLabel" Grid.Row="1" Text="Name des Ordners:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

        <!-- Input TextBox -->
        <TextBox x:Name="TxtFolderName" Grid.Row="2"
                 Height="34"
                 FontSize="13"
                 Padding="8,6"
                 VerticalContentAlignment="Center"
                 BorderBrush="#8A8886"
                 BorderThickness="1"
                 TextChanged="TxtFolderName_TextChanged"
                 KeyDown="TxtFolderName_KeyDown">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Error message -->
        <TextBlock x:Name="TxtError" Grid.Row="3" Margin="2,4,0,0" FontSize="11" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Abbrechen" Width="100" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnCancel_Click"
                    Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" FontSize="12">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="BtnOk" Content="Erstellen" MinWidth="100" Height="32" Padding="12,0"
                    IsDefault="True" Click="BtnOk_Click"
                    Background="{StaticResource AccentBrush}" Foreground="#FFFFFF"
                    FontWeight="SemiBold" BorderThickness="0" FontSize="12">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
